{
  "name": "@hyprune/sdk",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "description": "Experimental Hyprune IPC client, mock and author tools",
  "homepage": "https://hyprune.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyprune/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/hyprune/sdk/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./mock": {
      "types": "./dist/src/mock.d.ts",
      "import": "./dist/src/mock.js"
    }
  },
  "bin": {
    "hyprune": "dist/src/cli.js",
    "hyprune-mock": "dist/src/mock-cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "scenarios",
    "examples",
    "NOTES-rfc-gaps.md"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "npm run generate && tsc && node scripts/copy.mjs",
    "test": "npm run check:source && npm run build && tsc -p tsconfig.types.json && node --test test/*.test.mjs",
    "mock": "node dist/src/mock-cli.js",
    "hyprune": "node dist/src/cli.js",
    "prepare": "npm run build",
    "check:source": "node scripts/check-source.mjs",
    "test:bun": "npm run build && bun test test/protocol.test.mjs test/m1.test.mjs test/tooling.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "spdx-expression-parse": "4.0.0",
    "gltf-validator": "2.0.0-dev.3.10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  }
}
