        "methods": {
          "type": "array",
          "items": {
            "enum": [
              "session.hello",
              "session.ping",
              "state.subscribe",
              "state.snapshot",
              "state.unsubscribe",
              "world.load",
              "surface.focus",
              "movement.set",
              "shell.claim",
              "shell.release",
              "shell.overlay",
              "runtime.exit"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "events": {
          "type": "array",
          "items": {
            "enum": [
              "state.delta",
              "runtime.notice",
              "session.revoked"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "protocol",
        "sessionId",
        "capabilities",
        "methods",
        "events"
      ],
      "additionalProperties": false
    },
