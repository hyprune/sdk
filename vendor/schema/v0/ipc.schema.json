        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/capability"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "token": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "protocols",
        "client",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "session.hello.result": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "0.1"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/capability"
          },
          "minItems": 0,
          "uniqueItems": true
