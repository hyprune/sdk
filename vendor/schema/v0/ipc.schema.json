{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyprune.com/schema/v0/ipc.schema.json",
  "title": "Hyprune v0 ipc",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/notification"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "state": {
      "type": "object",
      "properties": {
        "runtime": {
          "type": "object",
          "properties": {
            "active": {
              "type": "boolean"
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "active",
            "outputs"
          ],
          "additionalProperties": false
        },
        "world": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "spawnId": {
                  "$ref": "common.schema.json#/$defs/slug"
                }
              },
              "required": [
                "id",
                "spawnId"
              ],
              "additionalProperties": false
            }
          ]
        },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "kind": {
                "enum": [
                  "window",
                  "workspace",
                  "layer",
                  "web",
                  "custom"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "logicalSize": {
                "type": "array",
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              },
              "focused": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "kind",
              "title",
              "logicalSize",
              "focused"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "movement": {
          "type": "object",
          "properties": {
            "modeId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "position": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "orientation": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            }
          },
          "required": [
            "modeId",
            "position",
            "orientation"
          ],
          "additionalProperties": false
        },
        "shell": {
          "type": "object",
          "properties": {
            "leases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "outputs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "overlays": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "outputId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "visible": {
                          "type": "boolean"
                        },
                        "exclusiveInput": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "outputId",
                        "visible",
                        "exclusiveInput"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "id",
                  "outputs",
                  "overlays"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            }
          },
          "required": [
            "leases"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "runtime",
        "world",
        "surfaces",
        "movement",
        "shell"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/revision"
        },
        "state": {
          "$ref": "#/$defs/state"
        }
      },
      "required": [
        "sessionId",
        "revision",
        "state"
      ],
      "additionalProperties": false
    },
    "session.hello.params": {
      "type": "object",
      "properties": {
        "protocols": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
