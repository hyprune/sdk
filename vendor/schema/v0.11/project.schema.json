{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyprune.com/schema/v0.11/project.schema.json",
  "title": "Hyprune builder project (builder/project.json, RFC-0014): projectVersion 0.1 or 0.2, published with world format 0.11",
  "type": "object",
  "properties": {
    "projectVersion": {
      "enum": [
        "0.1",
        "0.2"
      ]
    }
  },
  "required": [
    "projectVersion"
  ],
  "if": {
    "properties": {
      "projectVersion": {
        "const": "0.1"
      }
    }
  },
  "then": {
    "$ref": "#/$defs/project-0.1"
  },
  "else": {
    "$ref": "#/$defs/project-0.2"
  },
  "$defs": {
    "presetId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "project-0.1": {
      "type": "object",
      "properties": {
        "projectVersion": {
          "const": "0.1"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "starter": {
          "const": "flat-land@0.1"
        },
        "base": {
          "const": "builder/base.json"
        },
        "sky": {
          "type": "object",
          "properties": {
            "image": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "common.schema.json#/$defs/path"
                }
              ]
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "author": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "image",
            "license",
            "author",
            "source"
          ],
          "additionalProperties": false
        },
        "placements": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^u-[0-9a-f]{6}$"
              },
              "ref": {
                "type": "string",
                "pattern": "^world/[a-z][a-z0-9-]{0,63}$"
              },
              "pose": {
                "$ref": "common.schema.json#/$defs/pose"
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "workspace": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9999
              },
              "locked": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "ref",
              "pose",
              "scale"
            ],
            "additionalProperties": false
          }
        },
        "releaseUpload": {
          "type": "boolean"
        }
      },
      "required": [
        "projectVersion",
        "id",
        "name",
        "starter",
        "base",
        "sky",
        "placements"
      ],
      "additionalProperties": false
    },
    "project-0.2": {
      "type": "object",
      "properties": {
        "projectVersion": {
          "const": "0.2"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "starter": {
          "enum": [
            "open-plain@0.2",
            "flat-land@0.1"
          ],
          "description": "The starter the folder was made from: open-plain@0.2 (Open Plain, the default) or flat-land@0.1 (folders upgraded from projectVersion 0.1)."
        },
        "base": {
          "const": "builder/base.json"
        },
        "sky": {
          "type": "object",
          "properties": {
            "image": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "common.schema.json#/$defs/path"
                }
              ]
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "author": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "preset": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/presetId"
                }
              ],
              "description": "The built-in sky the image was generated from, or null for the user's own image."
            }
          },
          "required": [
            "image",
            "license",
            "author",
            "source"
          ],
          "additionalProperties": false
        },
        "placements": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^u-[0-9a-f]{6}$"
              },
              "ref": {
                "type": "string",
                "pattern": "^world/[a-z][a-z0-9-]{0,63}$"
              },
              "pose": {
                "$ref": "common.schema.json#/$defs/pose"
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "workspace": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9999
              },
              "locked": {
                "type": "boolean"
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48,
                "pattern": "^[a-z][a-z0-9-]{0,47}$",
                "description": "A stable name for the placement (RFC-0016), unique in the folder."
              },
              "behaviours": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/behaviour"
                },
                "maxItems": 8
              }
            },
            "required": [
              "id",
              "ref",
              "pose",
              "scale"
            ],
            "additionalProperties": false
          }
        },
        "releaseUpload": {
          "type": "boolean"
        },
        "floor": {
          "type": "object",
          "description": "The starter's floor: a built-in material or the user's own tileable image, repeated every `tile` metres.",
          "properties": {
            "preset": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/presetId"
                }
              ]
            },
            "image": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "common.schema.json#/$defs/path"
                }
              ]
            },
            "tile": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 100
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "author": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "preset",
            "image",
            "tile",
            "license",
            "author",
            "source"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "projectVersion",
        "id",
        "name",
        "starter",
        "base",
        "sky",
        "placements"
      ],
      "additionalProperties": false
    },
    "behaviour": {
      "description": "A data-driven display behaviour (RFC-0014 amendment): one published value drives one property between A (from) and B (to). Display only.",
