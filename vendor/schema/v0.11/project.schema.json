              "minItems": 3,
              "maxItems": 3
            },
            "to": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
