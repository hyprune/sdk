            "input": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "maxLength": 128,
                  "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$",
                  "description": "Default com.hyprune.sources.<placement id> (as a gauge)."
                },
                "key": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
                  "description": "Default value."
                },
                "min": {
                  "type": "number",
                  "minimum": -1000000000.0,
                  "maximum": 1000000000.0
                },
                "max": {
                  "type": "number",
                  "minimum": -1000000000.0,
                  "maximum": 1000000000.0
                }
              },
              "additionalProperties": false,
              "description": "The value read: min..max (default 0..100) maps to A..B."
            },
            "easing": {
              "enum": [
                "linear",
                "ease-in",
                "ease-out",
                "ease-in-out",
                "step"
              ]
            },
            "smoothing": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "Seconds to follow a change (default 0.3)."
            },
            "property": {
              "const": "scale"
            },
            "anchor": {
              "enum": [
                "bottom",
                "top",
                "left",
                "right",
                "front",
                "back",
                "centre"
              ]
            },
            "from": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 100
              },
              "minItems": 3,
              "maxItems": 3
            },
            "to": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 100
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "key",
            "property",
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,47}$"
