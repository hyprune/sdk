{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://hyprune.com/schema/registry/v0.1/content-lock.schema.json",
 "title": "Hyprune content lock 0.1 (RFC-0015): installed content declared for the Nix and Home Manager modules (`hyprune content lock`)",
 "type": "object",
 "properties": {
  "$schema": {
   "$ref": "index.schema.json#/$defs/https"
  },
  "lockVersion": {
   "const": "0.1"
  },
  "generated": {
   "type": "string",
   "maxLength": 40,
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
  },
  "packages": {
   "type": "array",
   "maxItems": 256,
   "items": {
    "$ref": "#/$defs/package"
   }
  }
 },
 "required": [
  "lockVersion",
  "packages"
 ],
 "additionalProperties": false,
 "$defs": {
  "package": {
   "description": "One installed world or library at an exact release: the archive URL and hash a fixed-output fetch uses (nixHash is the SRI form of sha256), and the source it came from (a label for people; the modules install it as system-managed content).",
   "type": "object",
   "properties": {
    "id": {
     "$ref": "index.schema.json#/$defs/id"
    },
    "type": {
     "enum": [
      "world",
      "library"
     ]
    },
    "version": {
     "$ref": "index.schema.json#/$defs/version"
    },
    "tag": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "$ref": "index.schema.json#/$defs/tag"
      }
     ]
    },
    "url": {
     "$ref": "index.schema.json#/$defs/https"
    },
    "sha256": {
     "$ref": "index.schema.json#/$defs/sha256"
    },
    "nixHash": {
     "type": "string",
     "pattern": "^sha256-[A-Za-z0-9+/]{43}=$"
    },
    "sourceId": {
     "type": "string",
     "minLength": 1,
     "maxLength": 512
    },
    "sourceLabel": {
     "type": "string",
     "minLength": 1,
     "maxLength": 160,
     "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "license": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "$ref": "index.schema.json#/$defs/license"
      }
     ]
    }
   },
   "required": [
    "id",
    "type",
    "version",
    "url",
    "sha256",
    "nixHash",
    "sourceId",
    "sourceLabel"
   ],
   "additionalProperties": false
  }
 }
}
